{
  "$schema": "https://docs.railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build && cd backend && composer install --no-dev --prefer-dist && php artisan optimize",
    "rootDirectory": "."
  },
  "deploy": {
    "startCommand": "php backend/artisan serve --host 0.0.0.0 --port ${PORT}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "nixpacks": {
    "phases": {
      "setup": {
        "commands": [
          "nix-env -iA nixpkgs.nodejs-18_x nixpkgs.npm-9_x nixpkgs.php nixpkgs.composer"
        ]
      }
    }
  }
}