# ==========================================
# Etapa 1: Build de Vue con Vite
# ==========================================
FROM node:20-alpine AS build-stage

WORKDIR /app

# Copiar archivos de dependencias
COPY package.json package-lock.json ./

# Instalar dependencias (Usamos install en lugar de ci para evitar errores de lockfile desincronizado)
RUN npm install

# Copiar archivos de configuración
COPY vite.config.js ./
COPY vite.config.frontend.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY index.html ./

# Copiar código fuente
COPY src ./src
COPY public ./public

# Copiar variables de entorno (ARG)
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

ARG VITE_BACKEND_URL
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

ARG VITE_SIGNALING_URL
ENV VITE_SIGNALING_URL=${VITE_SIGNALING_URL}

ARG VITE_APP_NAME
ENV VITE_APP_NAME=${VITE_APP_NAME}

# Build de producción usando la config específica de frontend
# (Evita que intente buscar archivos del backend que no existen aquí)
RUN npm run build -- --config vite.config.frontend.js

# ==========================================
# Etapa 2: Servidor Nginx
# ==========================================
FROM nginx:stable-alpine AS production-stage

# Copiar archivos compilados desde la etapa de build
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Crear configuración de Nginx para SPA
RUN echo 'server { \
    listen 8080; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ { \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
