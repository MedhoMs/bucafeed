# Stage 1: Build the Vue SPA
FROM node:20-alpine AS build-stage
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Build arg for API URL (set via Railway env vars)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:stable-alpine AS production-stage

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx template (uses $PORT variable)
COPY nginx.railway.conf /etc/nginx/templates/default.conf.template

# Copy built assets from dist
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Railway sets PORT dynamically, default to 80
ENV PORT=80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
