# =============================================================================
# TelamoNet - Configuración MySQL Hardening (producción)
# Montar en: /etc/mysql/conf.d/telamonet.cnf
# =============================================================================

[mysqld]
# ---- Seguridad ----
# Deshabilitar carga de archivos locales (protección contra LFI)
local_infile        = OFF
# Ocultar la versión de MySQL en el banner de conexión
version_comment     = ""
# No permitir uso del socket por usuarios sin privilegios
skip-networking     = OFF

# ---- Rendimiento y Alta Disponibilidad ----
# Buffer pool del InnoDB (ajustar según RAM disponible, ~70% de la RAM)
innodb_buffer_pool_size   = 256M
innodb_buffer_pool_instances = 1
# Flush de logs para mejor durabilidad (1 = más seguro, 2 = más rápido)
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1

# ---- Logging para auditoría ----
general_log        = OFF  # ON solo para diagnóstico temporal
general_log_file   = /var/log/mysql/general.log
slow_query_log     = ON
slow_query_log_file = /var/log/mysql/slow.log
long_query_time    = 2

# ---- Conexiones ----
max_connections        = 100
wait_timeout           = 600
interactive_timeout    = 600
max_allowed_packet     = 64M

# ---- Charset ----
character-set-server   = utf8mb4
collation-server       = utf8mb4_unicode_ci
