APP_NAME=TelamoNet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=telamonet
DB_USERNAME=telamo_user
DB_PASSWORD=telamo_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Configuración necesaria para Sanctum y CORS
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_DOMAIN=localhost

# Configuración de Resend
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@telamonet.com
MAIL_FROM_NAME="${APP_NAME}"
GEMINI_API_KEY=
SOCKET_URL=http://signaling:3000/

# TURN/ICE - Metered.live (nunca exponer esta clave en el frontend)
METERED_API_KEY=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

#API Key Groq para validar preguntas/respuestas
GROQ_API_KEY=gsk_0000000000000000000000000000000000000000000000000000