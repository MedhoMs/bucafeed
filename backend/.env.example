APP_NAME=TelamoNet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=telamonet
DB_USERNAME=telamo_user
DB_PASSWORD=telamo_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
