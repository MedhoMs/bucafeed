# TelamoNet — Variables de Entorno para Alta Disponibilidad (HA)
# =============================================================================
# Copiar este archivo como .env en el servidor de producción:
#   cp .env.ha.example .env
# y completar TODOS los valores marcados con <CAMBIAR>
# =============================================================================

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME="TelamoNet"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<CAMBIAR: php artisan key:generate --show>
APP_URL=https://<TU_DOMINIO>
APP_FRONTEND_URL=https://<TU_DOMINIO>

# ── Base de Datos ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=telamonet
DB_USERNAME=telamo_user
DB_PASSWORD=<CAMBIAR: contraseña segura >20 caracteres>
DB_ROOT_PASSWORD=<CAMBIAR: contraseña root segura >25 caracteres>
MYSQL_VERSION=8.0

# ── Redis (sesiones compartidas entre réplicas backend) ───────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<CAMBIAR: contraseña redis segura>

# ── Caché y Sesiones (usar Redis para HA) ────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120

# ── Puertos del Host ──────────────────────────────────────────────────────────
# En producción con HTTPS los puertos 80/443 son gestionados por Nginx/Certbot
NGINX_PORT=80
NGINX_HTTPS_PORT=443
# phpMyAdmin SOLO accesible desde localhost del servidor
PMA_PORT=8080

# ── Correo (Resend) ───────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=<CAMBIAR: tu API key de Resend>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@<TU_DOMINIO>
MAIL_FROM_NAME="TelamoNet"

# ── LiveKit (Videollamadas) ────────────────────────────────────────────────────
LIVEKIT_URL=<CAMBIAR: wss://tu-instancia.livekit.cloud>
LIVEKIT_API_KEY=<CAMBIAR>
LIVEKIT_API_SECRET=<CAMBIAR>

# ── Backups Automáticos ───────────────────────────────────────────────────────
BACKUP_REMOTE_HOST=<CAMBIAR: IP del servidor de backup>
BACKUP_REMOTE_USER=backup
BACKUP_REMOTE_PATH=/backups/telamonet
BACKUP_ENCRYPTION_KEY=<CAMBIAR: clave de cifrado AES-256 segura>
BACKUP_RETENTION_DAYS=7

# ── SSH Hardening ─────────────────────────────────────────────────────────────
# Puerto SSH personalizado (definido en harden.sh)
SSH_PORT=2222

# ── Dominio SSL ───────────────────────────────────────────────────────────────
DOMAIN=<TU_DOMINIO>
CERTBOT_EMAIL=<CAMBIAR: tu email para Let's Encrypt>
